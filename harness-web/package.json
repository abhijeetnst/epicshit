{
  "name": "dopecode-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n agent,web -c yellow,cyan \"npm:dev:agent\" \"npm:dev:web\"",
    "dev:web": "next dev -H 127.0.0.1 -p 3000",
    "dev:agent": "node -e \"require('fs').existsSync('../dist/cli.mjs')||(console.error('DopeCode is not built yet: run make setup in the repo root first.'),process.exit(1))\" && bun ../dist/cli.mjs agent",
    "dev:mock": "concurrently -k -n mock,web -c yellow,cyan \"npm:agent:mock\" \"npm:dev:web\"",
    "agent": "node -e \"require('fs').existsSync('../dist/cli.mjs')||(console.error('DopeCode is not built yet: run make setup in the repo root first.'),process.exit(1))\" && bun ../dist/cli.mjs agent",
    "agent:mock": "tsx watch mock-agent/server.ts",
    "build": "next build",
    "start": "concurrently -k -n agent,web -c yellow,cyan \"npm:agent\" \"next start -H 127.0.0.1 -p 3000\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "motion": "^12.43.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
