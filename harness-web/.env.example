# Copy to .env.local. The web app, the DopeCode agent (`npm run dev` / `npm run agent`, run by bun from
# this folder) and the mock agent all read it.

# Where the web app's proxy finds the agent (server-side only; never sent to the browser).
DOPECODE_AGENT_URL=http://127.0.0.1:4096

# Optional shared secret. The proxy sends it as "Authorization: Bearer ..." and the agent requires it.
# DOPECODE_AGENT_TOKEN=

# Extra hostnames allowed to use the web app, comma-separated (e.g. a dev tunnel).
# DOPECODE_WEB_ALLOWED_HOSTS=

# Port the agent listens on (DopeCode agent and mock agent).
# DOPECODE_AGENT_PORT=4096

# Mock agent only.
# DOPECODE_DATA_DIR=~/.dopecode-mock
