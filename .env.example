# Copy the variables you need into your shell (export ...). Never commit a real key.
# The only credential: a DeepSeek or Qwen (Alibaba Cloud Model Studio) key.
# An OpenRouter key (sk-or-...) also works, for testing only.
AI_API_KEY=

# Optional model configuration (auto-detected from the key when unset)
# AI_PROVIDER=deepseek   # or qwen, openrouter, openai, openai-compatible
# AI_MODEL=deepseek-flash
# AI_BASE_URL=https://api.deepseek.com
# AI_MAX_TOKENS=32000
# DOPE_TEST_CMD=npm test          # command the self-correcting loop runs (auto-detected when unset)
# DOPE_VERIFY_MAX_ITERATIONS=3
