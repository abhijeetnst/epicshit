{
  "name": "@epicshit-ai/dope-code",
  "version": "0.0.0",
  "description": "Dope Code CLI — terminal-only BYO OpenAI-compatible key build.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/entrypoints/cli.tsx",
  "bin": {
    "dope": "dist/cli.mjs"
  },
  "scripts": {
    "build": "bun scripts/build-bundle.ts",
    "build:watch": "bun scripts/build-bundle.ts --watch",
    "build:prod": "bun scripts/build-bundle.ts --minify",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
